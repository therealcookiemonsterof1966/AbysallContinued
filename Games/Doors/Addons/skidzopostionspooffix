return function(Window)
    local Library = Abysall.Interface.Library
    local Toggles = Library.Toggles

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")

    local LocalPlayer = Players.LocalPlayer

    local MrPasteGroundTab = Window:AddTab(
        "skidzopositionspooffix",
        "move-down"
    )
    print("balls")

    local MrPasteGroundGroupbox =
        MrPasteGroundTab:AddLeftGroupbox("skidzopositionspooffix")

    MrPasteGroundGroupbox:AddToggle("skidzopositionspooffix_Enabled", {
        Text = "skidzopositionspooffix",
        Default = false,
        Tooltip = "Fixes ground adhesion while Position Spoof is enabled."
    })

    local POAGroundParams = RaycastParams.new()
    POAGroundParams.FilterType = Enum.RaycastFilterType.Exclude
    POAGroundParams.RespectCanCollide = true
    POAGroundParams.IgnoreWater = true

    local POAGroundFilter = {}

    local POAGroundState = {
        WasEnabled = false,
        EnabledAt = 0
    }

    local function GetCharacter()
        local Character = LocalPlayer.Character

        if not Character or not Character.Parent then
            return nil, nil, nil
        end

        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        local RootPart = Character:FindFirstChild("HumanoidRootPart")

        return Character, Humanoid, RootPart
    end

    local function POAGroundAdhesion(Enabled)
        if not Enabled then
            POAGroundState.WasEnabled = false
            return
        end

        if not POAGroundState.WasEnabled then
            POAGroundState.WasEnabled = true
            POAGroundState.EnabledAt = os.clock()
        end

        local Character, Humanoid, RootPart = GetCharacter()

        if not (Character and Humanoid and RootPart) then
            return
        end

        if Humanoid.Health <= 0 then
            return
        end

        local State = Humanoid:GetState()

        if State == Enum.HumanoidStateType.Jumping
            or State == Enum.HumanoidStateType.Freefall
            or State == Enum.HumanoidStateType.Climbing
            or State == Enum.HumanoidStateType.Swimming
            or State == Enum.HumanoidStateType.Seated
        then
            return
        end

        table.clear(POAGroundFilter)

        POAGroundFilter[#POAGroundFilter + 1] = Character

        local Camera = Workspace.CurrentCamera

        if Camera then
            local MinecartRig = Camera:FindFirstChild("MinecartRig")

            if MinecartRig then
                POAGroundFilter[#POAGroundFilter + 1] = MinecartRig
            end
        end

        POAGroundParams.FilterDescendantsInstances = POAGroundFilter

        local V = RootPart.AssemblyLinearVelocity
        local Horizontal = Vector3.new(V.X, 0, V.Z)
        local Speed = Horizontal.Magnitude

        local Ahead = Speed > 0.5
            and Horizontal.Unit * math.clamp(Speed * 0.075, 0.75, 3.25)
            or Vector3.zero

        local CastUp = 2.25
        local CastDown = 8.5

        local Here = Workspace:Raycast(
            RootPart.Position + Vector3.new(0, CastUp, 0),
            Vector3.new(0, -(CastUp + CastDown), 0),
            POAGroundParams
        )

        local Forward = Workspace:Raycast(
            RootPart.Position + Ahead + Vector3.new(0, CastUp, 0),
            Vector3.new(0, -(CastUp + CastDown), 0),
            POAGroundParams
        )

        local Ground = Forward or Here

        if not Ground then
            return
        end

        local Grace =
            os.clock() - POAGroundState.EnabledAt < 0.18

        if V.Y > (Grace and 3 or 7) then
            RootPart.AssemblyLinearVelocity = Vector3.new(
                V.X,
                0,
                V.Z
            )

            V = RootPart.AssemblyLinearVelocity
        end

        if Forward and Here then
            local Drop =
                Here.Position.Y - Forward.Position.Y

            if Drop > 0.08
                and Drop < 5.5
                and V.Y > -42
            then
                local FollowY = -math.clamp(
                    10 + Speed * 0.42 + Drop * 12,
                    12,
                    42
                )

                RootPart.AssemblyLinearVelocity = Vector3.new(
                    V.X,
                    math.min(V.Y, FollowY),
                    V.Z
                )
            end
        elseif Forward and V.Y > -28 then
            RootPart.AssemblyLinearVelocity = Vector3.new(
                V.X,
                math.min(V.Y, -18),
                V.Z
            )
        end
    end

    Toggles.skidzopositionspooffix_Enabled:OnChanged(function(Value)
        if not Value then
            POAGroundAdhesion(false)
            return
        end

        POAGroundState.WasEnabled = false
        POAGroundState.EnabledAt = os.clock()

        Library:Notify(
            "skidzopositionspooffix",
            "skidzopositionspooffix enabled."
        )
    end)

    local Connection

    Connection = RunService.RenderStepped:Connect(function()
        local FixToggle =
            Toggles.skidzopositionspooffix_Enabled

        local PositionSpoofToggle =
            Toggles.PositionSpoof

        if not FixToggle
            or not FixToggle.Value
            or not PositionSpoofToggle
            or not PositionSpoofToggle.Value
        then
            POAGroundAdhesion(false)
            return
        end

        POAGroundAdhesion(true)
    end)

    LocalPlayer.CharacterRemoving:Connect(function()
        POAGroundState.WasEnabled = false
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        POAGroundState.WasEnabled = false

        if Toggles.skidzopositionspooffix_Enabled.Value
            and Toggles.PositionSpoof
            and Toggles.PositionSpoof.Value
        then
            POAGroundState.EnabledAt = os.clock()
        end
    end)

    if Abysall.Addon
        and type(Abysall.Addon.OnUnload) == "function"
    then
        Abysall.Addon.OnUnload(function()
            POAGroundAdhesion(false)

            if Connection then
                Connection:Disconnect()
                Connection = nil
            end
        end)
    end
end
