return function(Window)
    local Library = Abysall.Interface.Library
    local Toggles = Library.Toggles

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")

    local LocalPlayer = Players.LocalPlayer

    local MrPasteGroundTab = Window:AddTab(
        "skidzopositionspooffix",
        "move-down"
    )

    local MrPasteGroundGroupbox =
        MrPasteGroundTab:AddLeftGroupbox("skidzopositionspooffix")

    MrPasteGroundGroupbox:AddToggle("skidzopositionspooffix_Enabled", {
        Text = "skidzopositionspooffix",
        Default = true,
        Tooltip = "Uses the ground below you to keep Position Spoof grounded."
    })

    local GroundRaycastParams = RaycastParams.new()
    GroundRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
    GroundRaycastParams.RespectCanCollide = true
    GroundRaycastParams.IgnoreWater = true

    local GroundRaycastFilter = {}

    local Connection

    Connection = RunService.RenderStepped:Connect(function()
        local FixToggle = Toggles.skidzopositionspooffix_Enabled
        local PositionSpoofToggle = Toggles.PositionSpoof

        if not FixToggle
            or not FixToggle.Value
            or not PositionSpoofToggle
            or not PositionSpoofToggle.Value
        then
            return
        end

        local Character = LocalPlayer.Character

        if not Character or not Character.Parent then
            return
        end

        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        local RootPart = Character:FindFirstChild("HumanoidRootPart")

        if not Humanoid or not RootPart or Humanoid.Health <= 0 then
            return
        end

        local State = Humanoid:GetState()

        if State == Enum.HumanoidStateType.Jumping
            or State == Enum.HumanoidStateType.Freefall
            or State == Enum.HumanoidStateType.Climbing
            or State == Enum.HumanoidStateType.Swimming
            or State == Enum.HumanoidStateType.Seated
        then
            return
        end

        table.clear(GroundRaycastFilter)
        GroundRaycastFilter[#GroundRaycastFilter + 1] = Character

        GroundRaycastParams.FilterDescendantsInstances = GroundRaycastFilter

        local RayOrigin = RootPart.Position + Vector3.new(0, 2, 0)
        local RayDirection = Vector3.new(0, -8, 0)

        local Ground = Workspace:Raycast(
            RayOrigin,
            RayDirection,
            GroundRaycastParams
        )

        if not Ground then
            return
        end

        local GroundY = Ground.Position.Y
        local RootBottomY = RootPart.Position.Y - (RootPart.Size.Y * 0.5)
        local Difference = RootBottomY - GroundY

        if Difference > 0.02 then
            local Offset = math.min(Difference, 0.15)

            RootPart.CFrame = RootPart.CFrame * CFrame.new(
                0,
                -Offset,
                0
            )
        end
    end)

    if Abysall.Addon
        and type(Abysall.Addon.OnUnload) == "function"
    then
        Abysall.Addon.OnUnload(function()
            if Connection then
                Connection:Disconnect()
                Connection = nil
            end
        end)
    end
end
