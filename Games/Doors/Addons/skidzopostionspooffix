return function(Window)
    local Library = Abysall.Interface.Library
    local Toggles = Library.Toggles

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")

    local LocalPlayer = Players.LocalPlayer

    local MrPasteGroundTab = Window:AddTab(
        "skidzopositionspooffix",
        "move-down"
    )

    local MrPasteGroundGroupbox =
        MrPasteGroundTab:AddLeftGroupbox("skidzopositionspooffix")

    MrPasteGroundGroupbox:AddToggle("skidzopositionspooffix_Enabled", {
        Text = "skidzopositionspooffix",
        Default = true,
        Tooltip = "Prevents Position Spoof from floating or launching on stairs."
    })

    local GroundRaycastParams = RaycastParams.new()
    GroundRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
    GroundRaycastParams.RespectCanCollide = true
    GroundRaycastParams.IgnoreWater = true

    local GroundRaycastFilter = {}

    local Connection

    Connection = RunService.RenderStepped:Connect(function()
        local FixToggle = Toggles.skidzopositionspooffix_Enabled
        local PositionSpoofToggle = Toggles.PositionSpoof

        if not FixToggle
            or not FixToggle.Value
            or not PositionSpoofToggle
            or not PositionSpoofToggle.Value
        then
            return
        end

        local Character = LocalPlayer.Character

        if not Character or not Character.Parent then
            return
        end

        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        local RootPart = Character:FindFirstChild("HumanoidRootPart")

        if not Humanoid or not RootPart or Humanoid.Health <= 0 then
            return
        end

        local State = Humanoid:GetState()

        if State == Enum.HumanoidStateType.Jumping
            or State == Enum.HumanoidStateType.Climbing
            or State == Enum.HumanoidStateType.Swimming
            or State == Enum.HumanoidStateType.Seated
        then
            return
        end

        table.clear(GroundRaycastFilter)
        GroundRaycastFilter[#GroundRaycastFilter + 1] = Character

        local Camera = Workspace.CurrentCamera

        if Camera then
            local MinecartRig = Camera:FindFirstChild("MinecartRig")

            if MinecartRig then
                GroundRaycastFilter[#GroundRaycastFilter + 1] = MinecartRig
            end
        end

        GroundRaycastParams.FilterDescendantsInstances = GroundRaycastFilter

        local Velocity = RootPart.AssemblyLinearVelocity
        local HorizontalVelocity = Vector3.new(
            Velocity.X,
            0,
            Velocity.Z
        )

        local Speed = HorizontalVelocity.Magnitude

        if Speed < 0.1 then
            return
        end

        local Direction = HorizontalVelocity.Unit
        local LookAhead = math.clamp(
            Speed * 0.12,
            1.5,
            4
        )

        local RayHeight = 3
        local RayLength = 9

        local CurrentGround = Workspace:Raycast(
            RootPart.Position + Vector3.new(0, RayHeight, 0),
            Vector3.new(0, -RayLength, 0),
            GroundRaycastParams
        )

        local ForwardGround = Workspace:Raycast(
            RootPart.Position
                + Direction * LookAhead
                + Vector3.new(0, RayHeight, 0),
            Vector3.new(0, -RayLength, 0),
            GroundRaycastParams
        )

        if not CurrentGround or not ForwardGround then
            return
        end

        local CurrentY = CurrentGround.Position.Y
        local ForwardY = ForwardGround.Position.Y
        local GroundDifference = ForwardY - CurrentY

        if GroundDifference < -0.08 then
            local Drop = math.min(-GroundDifference, 5)

            local DownwardVelocity = math.clamp(
                8 + Drop * 12 + Speed * 0.35,
                10,
                42
            )

            if Velocity.Y > -DownwardVelocity then
                RootPart.AssemblyLinearVelocity = Vector3.new(
                    Velocity.X,
                    -DownwardVelocity,
                    Velocity.Z
                )
            end
        elseif GroundDifference > 0.08 then
            local Rise = math.min(GroundDifference, 3)

            local UpwardVelocity = math.clamp(
                Rise * 10 + Speed * 0.2,
                4,
                18
            )

            if Velocity.Y < UpwardVelocity then
                RootPart.AssemblyLinearVelocity = Vector3.new(
                    Velocity.X,
                    UpwardVelocity,
                    Velocity.Z
                )
            end
        end
    end)

    if Abysall.Addon
        and type(Abysall.Addon.OnUnload) == "function"
    then
        Abysall.Addon.OnUnload(function()
            if Connection then
                Connection:Disconnect()
                Connection = nil
            end
        end)
    end
end
