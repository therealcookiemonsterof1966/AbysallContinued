return function(Window)
    print("this not even his anymore")
    local Library = Abysall.Interface.Library
    local Toggles = Library.Toggles

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")

    local LocalPlayer = Players.LocalPlayer

    local MrPasteGroundTab = Window:AddTab(
        "skidzopositionspooffix",
        "move-down"
    )

    local MrPasteGroundGroupbox =
        MrPasteGroundTab:AddLeftGroupbox("skidzopositionspooffix")

    MrPasteGroundGroupbox:AddToggle("skidzopositionspooffix_Enabled", {
        Text = "skidzopositionspooffix",
        Default = true,
        Tooltip = "Keeps Position Spoof grounded unless jumping."
    })

    local Connection

    Connection = RunService.RenderStepped:Connect(function()
        local FixToggle = Toggles.skidzopositionspooffix_Enabled
        local PositionSpoofToggle = Toggles.PositionSpoof

        if not FixToggle
            or not FixToggle.Value
            or not PositionSpoofToggle
            or not PositionSpoofToggle.Value
        then
            return
        end

        local Character = LocalPlayer.Character

        if not Character or not Character.Parent then
            return
        end

        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        local RootPart = Character:FindFirstChild("HumanoidRootPart")

        if not Humanoid or not RootPart or Humanoid.Health <= 0 then
            return
        end

        if Humanoid:GetState() == Enum.HumanoidStateType.Jumping then
            return
        end

        local Velocity = RootPart.AssemblyLinearVelocity

        if Velocity.Y > -8 then
            RootPart.AssemblyLinearVelocity = Vector3.new(
                Velocity.X,
                -8,
                Velocity.Z
            )
        end
    end)

    if Abysall.Addon
        and type(Abysall.Addon.OnUnload) == "function"
    then
        Abysall.Addon.OnUnload(function()
            if Connection then
                Connection:Disconnect()
                Connection = nil
            end
        end)
    end
end
